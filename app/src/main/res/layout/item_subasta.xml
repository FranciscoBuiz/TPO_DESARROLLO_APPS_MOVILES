<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_tag_border"> <!-- Using the same border for the whole card to match the sketch look -->

        <ImageView
            android:id="@+id/iv_subasta"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/light_gray"
            android:src="@android:color/darker_gray" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tv_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subasta 1"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_moneda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tag_border"
                android:text="USD"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CATEGORIA: PLATA"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_finaliza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FINALIZA: 15 OCT - 18:00HS"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btn_entrar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_yellow"
            android:text="ENTRAR"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.cardview.widget.CardView>